# Isi melalui Supabase Dashboard > Project Settings > API.
# Semua nilai ini hanya untuk server. Jangan taruh key di HTML/JS publik.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Jika project masih memakai key legacy, isi service_role di bawah sebagai pengganti.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gsa-moments

# Opsional: port preview lokal. Default 8000.
PORT=8000
